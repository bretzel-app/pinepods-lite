{
  // Typechecks the job's modules and their tests. main.ts and db.ts use Bun's APIs
  // (Bun.spawn, Bun.SQL) and are left to `bun build`.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["*.ts"],
  "exclude": ["main.ts", "db.ts", "dist"]
}
